# --- LangSmith (required for all modules) ---
LANGSMITH_TRACING="true"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="<langsmith-api-key>"
LANGSMITH_PROJECT="financial-research-workshop"

# Set this to the same value as LANGSMITH_API_KEY — only required if you flip
# utils/models.py to the gateway-routed block (Module 2 §1.4).
LANGSMITH_API_KEY_GATEWAY="<langsmith-api-key>"

# Workspace ID for the gateway policy created in Module 2.
# Find it in LangSmith Settings → Workspace.
WORKSPACE_ID="<workspace-id>"

# --- Model providers ---
# Default model is OpenAI (gpt-4.1-mini) routed through the LangSmith LLM Gateway.
OPENAI_API_KEY="<openai-api-key>"

# Optional alternatives — only required if you swap the default in utils/models.py.
# ANTHROPIC_API_KEY="<anthropic-api-key>"

# Azure OpenAI (optional alternative)
# AZURE_OPENAI_API_KEY="<azure-openai-api-key>"
# AZURE_OPENAI_ENDPOINT="<azure-openai-endpoint>"
# AZURE_OPENAI_API_VERSION=""

# AWS Bedrock (optional alternative)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION_NAME=""
# AWS_MODEL_ARN=""

# Web search is the model provider's native tool (OpenAI's built-in web_search
# by default), so no separate search API key is required — it uses
# OPENAI_API_KEY above (or ANTHROPIC_API_KEY if you switch providers).
